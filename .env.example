# ---------------------------------------------------------------------------
# TubeTrace MCP configuration. Copy to .env and fill in. NEVER commit .env.
# Three kinds of values:
#   * server secrets      -> YOUTUBE_API_KEY (Google API key, restricted to YouTube Data API v3)
#   * client credential   -> the bearer token lives ONLY on the client (TUBETRACE_MCP_TOKEN);
#                            the server stores just its SHA-256 digest in MCP_TOKEN_SHA256
#   * non-secret settings -> everything else
# ---------------------------------------------------------------------------

# development | production. Production requires MCP_TOKEN_SHA256 and MCP_DOMAIN,
# and forbids AUTH_DISABLED.
APP_ENV=development

# Bind address for the app itself (Caddy sits in front in production).
HOST=127.0.0.1
PORT=8000

# Google API key with API restriction "YouTube Data API v3". Optional: without it
# youtube_search_videos returns GOOGLE_API_NOT_CONFIGURED; transcript tools still work.
YOUTUBE_API_KEY=

# SHA-256 hex digest(s) of the client bearer token, produced by
# `uv run tubetrace-mcp generate-token`. Comma-separate two digests during rotation.
MCP_TOKEN_SHA256=

# Development only: explicitly allow anonymous access on loopback. Ignored/rejected in production.
AUTH_DISABLED=false

# bearer (default): this process verifies Authorization: Bearer against MCP_TOKEN_SHA256.
# platform: a managed MCP gateway (Prefect Horizon with Horizon authentication enabled)
# authenticates callers; the process does no token verification and MCP_TOKEN_SHA256 /
# AUTH_DISABLED must be unset. Never use "platform" for a directly reachable server.
AUTH_MODE=bearer

# Public hostname served by Caddy (also added to the accepted Host header values).
MCP_DOMAIN=mcp.example.com
# Contact e-mail for Let's Encrypt (Caddy only).
ACME_EMAIL=you@example.com

# Extra accepted Host header values / browser Origins (comma-separated). Usually empty.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# Proxy trust: only these addresses may set X-Forwarded-* (uvicorn syntax; compose sets it).
FORWARDED_ALLOW_IPS=127.0.0.1

# Logging: DEBUG|INFO|WARNING|ERROR, json|text
LOG_LEVEL=INFO
LOG_FORMAT=json

# Answer MCP POST requests with application/json (true) instead of SSE streams.
MCP_JSON_RESPONSE=true

# --- upstream timeouts, retries, concurrency (seconds) ---
GOOGLE_CONNECT_TIMEOUT_SECONDS=5
GOOGLE_READ_TIMEOUT_SECONDS=10
TRANSCRIPT_CONNECT_TIMEOUT_SECONDS=5
TRANSCRIPT_READ_TIMEOUT_SECONDS=15
UPSTREAM_MAX_RETRIES=2
UPSTREAM_RETRY_BUDGET_SECONDS=20
UPSTREAM_MAX_CONCURRENCY=4
UPSTREAM_QUEUE_TIMEOUT_SECONDS=10
TOOL_TIMEOUT_SECONDS=45

# --- cache (process-local, not shared between replicas) ---
SEARCH_CACHE_TTL_SECONDS=300
TRANSCRIPT_CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=512
CACHE_MAX_BYTES=67108864

# --- limits ---
MAX_RESPONSE_BYTES=200000
TRANSCRIPT_MAX_SEGMENTS=50000
TRANSCRIPT_MAX_BYTES=8388608
GOOGLE_MAX_RESPONSE_BYTES=2097152
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
